{
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"target": "es2015",
		"declaration": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"lib": [
			"dom",
			"es2018"
		],
		"experimentalDecorators": true
	},

	"include": ["src/*"]
}
